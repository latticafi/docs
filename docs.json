        "root": "trading/index",
        "expanded": true,
        "pages": [
          "trading/fees",
          "trading/leverage-terms",
          "trading/market-selection",
          "trading/order-types",
          "trading/margin",
          "trading/liquidation",
          "trading/tp-sl",
          "trading/closing-trades",
          "trading/slippage"
