        "expanded": true,
        "pages": [
          "lattica-101",
          "team"
        ]
      },
      {
        "group": "Onboarding",
        "root": "onboarding/index",
        "expanded": true,
        "pages": [
          "onboarding/start-trading",
          "onboarding/borrow",
          "onboarding/leverage-trade",
          "onboarding/provide-liquidity",
